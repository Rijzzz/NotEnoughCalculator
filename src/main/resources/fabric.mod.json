{
  "schemaVersion": 1,
  "id": "notenoughcalculator",
  "version": "${version}",
  "name": "Not Enough Calculator",
  "description": "A NEU-style calculator that works standalone or inside Roughly Enough Items & Skyblock Item List search bars!",
  "authors": [
    "Rijz",
    "Laze"
  ],
  "contributors": [
    "kaori-23",
    "ninjaguardian",
    "Spagles"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/notenoughcalculator",
    "issues": "https://github.com/Rijzzz/NotEnoughCalculator/issues"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/notenoughcalculator/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.rijz.notenoughcalculator.NotEnoughCalculator"
    ],
    "client": [
      "com.rijz.notenoughcalculator.client.NotEnoughCalculatorClient"
    ],
    "rei_client": [
      "com.rijz.notenoughcalculator.client.integration.plugin.CalculatorREIPlugin"
    ],
    "modmenu": [
      "com.rijz.notenoughcalculator.client.integration.plugin.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "notenoughcalculator.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${min_loader_version}",
    "fabric-api": ">=${min_fabric_api_version}",
    "fabric-language-kotlin": ">=${fabric_language_kotlin_version}",
    "minecraft": ">=${minecraft_version}"
  },
  "suggests": {
    "roughlyenoughitems": ">=${rei_version}",
    "modmenu": ">=${min_modmenu_version}",
    "skyblock-item-list": ">=${skyblockitemlist_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/notenoughcalculator",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/notenoughcalculator",
        "modmenu.discord": "https://discord.com/invite/asPJ4qgs8q",
        "modmenu.source": "https://github.com/Rijzzz/NotEnoughCalculator"
      }
    }
  }
}