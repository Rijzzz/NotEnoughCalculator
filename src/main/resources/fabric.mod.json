{
  "schemaVersion": 1,
  "id": "notenoughcalculator",
  "version": "${version}",
  "name": "Not Enough Calculator",
  "description": "A NEU-style calculator, inside REI's search bar.",
  "authors": [
    "Rijz",
    "Laze"
  ],
  "contributors": [
    "kaori-23",
    "ninjaguardian"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/notenoughcalculator",
    "issues": "https://github.com/Rijzzz/NotEnoughCalculator/issues"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/notenoughcalculator/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.rijz.notenoughcalculator.NotEnoughCalculator"
    ],
    "client": [
      "com.rijz.notenoughcalculator.client.NotEnoughCalculatorClient"
    ],
    "rei_client": [
      "com.rijz.notenoughcalculator.client.CalculatorREIPlugin"
    ],
    "modmenu": [
      "com.rijz.notenoughcalculator.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "notenoughcalculator.mixins.json",
    {
      "config": "notenoughcalculator.client.mixins.json",
      "environment": "client"
    }
  ],
"depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${min_fabric_api_version}",
    "minecraft": ">=${min_minecraft_version} <=${max_minecraft_version}",
    "roughlyenoughitems": ">=${min_rei_version}"
  },
  "suggests": {
    "modmenu": ">=${min_modmenu_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/notenoughcalculator",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/notenoughcalculator",
        "modmenu.discord": "https://discord.com/users/1303959182201982989",
        "modmenu.source": "https://github.com/Rijzzz/NotEnoughCalculator"
      }
    }
  }
}
